sealed interface Shape permits Circle, Square {
  double area()
}

record Circle(double r) implements Shape {
  public double area() {
    return 3.0 * r * r
  }
}

record Square(double side) implements Shape {
  public double area() {
    return side * side
  }
}

class Rank {
  public static String of(Shape s) {
    String kind = switch (s) {
      case Circle c -> "round"
      case Square q -> "flat"
    }
    return kind
  }
}
